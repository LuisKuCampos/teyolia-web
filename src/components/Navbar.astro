<nav
  id="main-nav"
  class="fixed w-full z-50 mix-blend-difference text-white py-6 px-8 flex justify-between items-center bg-transparent transition-all duration-300 hover:bg-black/20"
>
  <div
    class="hidden md:flex space-x-8 text-xs tracking-[0.2em] font-medium uppercase"
  >
    <a
      class="hover:text-primary transition-colors duration-300 relative group"
      href="/"
    >
      Inicio
      <span
        class="absolute -bottom-1 left-0 w-0 h-[1px] bg-primary transition-all duration-300 group-hover:w-full"
      ></span>
    </a>
  </div>
  <a
    href="/"
    class="text-2xl md:text-3xl font-display font-semibold tracking-widest uppercase absolute left-1/2 transform -translate-x-1/2 hover:scale-105 transition-transform duration-300"
  >
    Teyolia
  </a>
  <div
    class="hidden md:flex space-x-8 text-xs tracking-[0.2em] font-medium uppercase"
  >
    <a
      class="hover:text-primary transition-colors duration-300 relative group"
      href="/sobremi"
    >
      Sobre Mi

      <span
        class="absolute -bottom-1 left-0 w-0 h-[1px] bg-primary transition-all duration-300 group-hover:w-full"
      ></span>
    </a>
  </div>
  <button
    id="mobile-menu-btn"
    class="md:hidden text-white z-[60] relative transition-colors duration-300"
  >
    <span class="material-icons-outlined text-3xl drop-shadow-md">menu</span>
  </button>
</nav>

<!-- Menú Móvil Desplegable -->
<div
  id="mobile-menu"
  class="fixed inset-0 bg-black/60 backdrop-blur-lg flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-500 z-[70] translate-x-full"
>
  <!-- Botón de Cerrar Dedicado -->
  <button
    id="close-menu-btn"
    class="absolute top-6 right-8 text-white md:hidden"
  >
    <span class="material-icons-outlined text-3xl drop-shadow-md">close</span>
  </button>

  <div
    class="flex flex-col space-y-10 text-center text-xl tracking-[0.25em] font-medium uppercase mt-12"
  >
    <a
      class="mobile-link text-gray-200 hover:text-white hover:scale-110 transition-all duration-300"
      href="/"
    >
      Inicio
    </a>
    <a
      class="mobile-link text-gray-200 hover:text-white hover:scale-110 transition-all duration-300"
      href="/sobremi"
    >
      Sobre Mi
    </a>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const openBtn = document.getElementById("mobile-menu-btn");
    const closeBtn = document.getElementById("close-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const links = document.querySelectorAll(".mobile-link");

    const openMenu = () => {
      menu?.classList.remove(
        "opacity-0",
        "pointer-events-none",
        "translate-x-full",
      );
      document.body.style.overflow = "hidden"; // Evitar scroll
    };

    const closeMenuObj = () => {
      menu?.classList.add(
        "opacity-0",
        "pointer-events-none",
        "translate-x-full",
      );
      document.body.style.overflow = ""; // Restaurar scroll
    };

    openBtn?.addEventListener("click", openMenu);
    closeBtn?.addEventListener("click", closeMenuObj);

    // Cerrar el menú si hacen clic en cualquier enlace
    links.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenuObj();
      });
    });
  });
</script>
